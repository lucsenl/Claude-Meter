                android:resource="@xml/samsung_lock_bars_wide_oneui_info"/>
        </receiver>
        <receiver
            android:label="@string/lock_widget_five_hour_name"
            android:name="dev.lucsenl.claudemeter.SamsungLockFiveHourWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/samsung_lock_five_hour_info"/>
            <meta-data
                android:name="samsung.appwidget.monotone.info"
                android:resource="@xml/samsung_lock_five_hour_oneui_info"/>
        </receiver>
        <receiver
            android:label="@string/lock_widget_weekly_name"
            android:name="dev.lucsenl.claudemeter.SamsungLockWeeklyWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/samsung_lock_weekly_info"/>
            <meta-data
                android:name="samsung.appwidget.monotone.info"
                android:resource="@xml/samsung_lock_weekly_oneui_info"/>
        </receiver>
        <receiver
            android:name="dev.lucsenl.claudemeter.SamsungLockServiceBoxReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.samsung.android.intent.action.REQUEST_SERVICEBOX_REMOTEVIEWS"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="dev.lucsenl.claudemeter.WidgetRefreshReceiver"
            android:exported="false"/>
        <receiver
            android:name="dev.lucsenl.claudemeter.ResetAlertReceiver"
            android:exported="false"/>
        <receiver
            android:name="dev.lucsenl.claudemeter.UpdateInstallReceiver"
            android:exported="false"/>
        <receiver
            android:name="dev.lucsenl.claudemeter.ResetCreditExpiryReceiver"
            android:exported="false"/>
        <receiver
            android:name="dev.lucsenl.claudemeter.NowBarActionReceiver"
            android:exported="false"/>
        <receiver
            android:name="dev.lucsenl.claudemeter.BootReceiver"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <meta-data
            android:name="SamsungBasicInteraction"
            android:value="SEP10"/>
        <meta-data
            android:name="com.samsung.android.support.ongoing_activity"
            android:value="true"/>
    </application>
</manifest>
