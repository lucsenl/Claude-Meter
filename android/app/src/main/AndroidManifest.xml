<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="dev.lucsenl.claudemeter.permission.INTERNAL"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.lucsenl.claudemeter.permission.INTERNAL" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="dev.lucsenl.claudemeter.ClaudeMeterApplication"
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <activity
            android:name="dev.lucsenl.claudemeter.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="dev.lucsenl.claudemeter.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name="dev.lucsenl.claudemeter.SettingsActivity"
            android:exported="false" />
        <activity
            android:name="dev.lucsenl.claudemeter.AboutActivity"
            android:exported="false" />

        <receiver
            android:name="dev.lucsenl.claudemeter.ClaudeUsageWidget"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/claude_widget_info" />
        </receiver>

        <receiver
            android:name="dev.lucsenl.claudemeter.WidgetRefreshReceiver"
            android:exported="false" />

        <service
            android:name="dev.lucsenl.claudemeter.UsageRefreshJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>
</manifest>
